# Sanity — product catalog (names, images, descriptions). Run `npx sanity@latest init`
# in this folder to create a free account/project, or get these from an existing
# project at sanity.io/manage. Dataset is usually "production".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Neon (Postgres) — connection string from your Neon project dashboard.
# Required for auth (login/register) and order storage.
DATABASE_URL=

# Auth.js — random 32+ char secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js — public URL of the deployed site. Required in production behind a
# reverse proxy: without it, Auth.js sometimes fails to detect the right host
# from request headers alone (even with trustHost: true), which breaks OAuth
# redirect URIs (e.g. Google sign-in). Must match NEXT_PUBLIC_SITE_URL below,
# no trailing slash.
AUTH_URL=

# Google sign-in — from a project at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Authorized redirect URI must be
# exactly: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple sign-in — requires a paid Apple Developer account. Needs a Services ID
# (used as AUTH_APPLE_ID), a Sign In with Apple key (.p8 file), your Team ID
# and Key ID from https://developer.apple.com/account/resources — then run
# `npx auth add apple` from this folder, it asks for those and writes a signed
# JWT as AUTH_APPLE_SECRET (this JWT expires after up to 6 months and must be
# regenerated the same way). On the Services ID, set:
#   Domain: <your domain, no https://>
#   Return URL: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/apple
# Apple requires HTTPS — this cannot be tested on localhost.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# SMTP — sends the "mot de passe oublié" email, via an existing mailbox
# (e.g. one hosted on OVH). Find the exact host/port for your mailbox under
# "Emails" > your address > "Configurer mon logiciel de messagerie" in the
# OVH manager — typically:
#   SMTP_HOST=ssl0.ovh.net (or the pro/regional host OVH shows you)
#   SMTP_PORT=465
# SMTP_USER/SMTP_PASS are the mailbox's own address and password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset. Use "Name <address>" to set a display name.
SMTP_FROM=

# Brevo (newsletter) — create a free account at https://www.brevo.com, then:
#   - API key: Settings (your name, top right) > SMTP & API > API Keys > Generate a new API key
#   - List ID: Contacts > Lists > create a list (e.g. "Newsletter") > open it,
#     the ID is in the URL and also shown on the list's page.
# Composing and sending campaigns happens on brevo.com itself — the site only
# adds people to this list when they sign up in the footer form.
BREVO_API_KEY=
BREVO_LIST_ID=

# AfterShip (suivi de colis) — crée un compte gratuit sur https://www.aftership.com
# (jusqu'à 100 colis suivis/mois gratuitement), puis récupère une clé API dans
# Settings > API Keys. Détecte automatiquement la plupart des transporteurs à
# partir du numéro de suivi seul.
AFTERSHIP_API_KEY=

# Emails de compte autorisés à accéder aux pages d'administration
# (/admin/commandes) — sépare par des virgules si plusieurs. Utilise l'email
# du compte avec lequel tu te connectes sur le site. Reçoivent aussi une
# notification par email à chaque nouvelle commande payée.
ADMIN_EMAILS=

# Stripe — from https://dashboard.stripe.com/test/apikeys (test mode to start).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI or the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# Base URL of the deployed site, used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
