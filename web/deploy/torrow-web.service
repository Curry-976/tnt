[Unit]
Description=Torrow Nam Torrow — Next.js site
After=network.target

[Service]
Type=simple
# Adjust to the path where you clone/deploy the repo on the VPS.
WorkingDirectory=/var/www/torrow-web
# Standalone output's server.js listens on PORT (default 3000).
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/torrow-web/.env.local
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
User=www-data

[Install]
WantedBy=multi-user.target
