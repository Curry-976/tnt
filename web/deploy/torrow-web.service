[Unit]
Description=Torrow Nam Torrow — Next.js site
After=network.target

[Service]
Type=simple
# Adjust to the path where you clone/deploy the repo on the VPS.
WorkingDirectory=/var/www/torrow-web/web
Environment=NODE_ENV=production
Environment=PORT=3000
# next start reads .env.local itself from WorkingDirectory, no EnvironmentFile needed.
ExecStart=/var/www/torrow-web/web/node_modules/.bin/next start -p 3000
Restart=on-failure
RestartSec=5
User=www-data

[Install]
WantedBy=multi-user.target
